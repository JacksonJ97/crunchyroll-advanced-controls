{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",

    "target": "es2025",
    "module": "esnext",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["chrome-types"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
