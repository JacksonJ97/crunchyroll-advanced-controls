{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "unicorn", "typescript"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist/**"],
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "error"
  }
}
