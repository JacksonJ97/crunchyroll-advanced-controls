{
  "manifest_version": 3,
  "name": "Crunchyroll Advanced Controls",
  "version": "1.0.0",
  "description": "Adds additional playback controls to Crunchyroll's video player.",
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://www.crunchyroll.com/*"]
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
